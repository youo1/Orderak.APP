# Keep repository text deterministic across Windows, macOS, and Linux.
* text=auto eol=lf

# Windows-native launchers remain CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-ending normalized.
*.ico binary
*.jar binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.xlsx binary
