{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "promise", "import"],
  "rules": {
    // The reason this file exists: async-correctness rules that need type
    // information. `lint` passes --type-aware, backed by oxlint-tsgolint.
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "promise/no-return-wrap": "error",

    // --type-aware also pulls these in. They fire on a pattern that is
    // deliberate here: D1 rows are typed Record<string, unknown>, so every
    // String(row.column) reads as a base-to-string violation.
    //
    // Measured 2026-08-22 rather than estimated: 361 no-base-to-string and 13
    // restrict-template-expressions, across 25 files. The earlier note said
    // "~370" and "re-enable once row types are modelled properly", which is
    // still the right fix — but at this size it is a typing project, not a
    // lint cleanup, and nothing tracked it. Turning these on without modelling
    // the row types first would only trade 374 errors for 374 suppressions.
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off"
  },
  "ignorePatterns": ["src/generated/**", "dist/**"]
}
