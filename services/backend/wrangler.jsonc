/**
 * PRODUCTION IS THE BASE ENVIRONMENT IN THIS FILE.
 *
 * `wrangler deploy` with no `--env` deploys PRODUCTION. Staging lives under
 * `env.staging` and needs `--env staging`. There is deliberately no
 * `env.production` — see docs/architecture/deployment-environment-map.md.
 *
 * Use the package scripts, never bare wrangler:
 *   pnpm run deploy:staging      -> staging   (this is the default `deploy`)
 *   pnpm run deploy:production   -> production, and production deploys are
 *                                   FROZEN as of 2026-08-24 while the project
 *                                   is in testing. See production-deploy.yml.
 */
/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "orderak-worker",
	"main": "src/entrypoints/public-worker.ts",
	"compatibility_date": "2026-07-29",
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 0.1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.05 }
	},
	"upload_source_maps": true,
	"vars": {
		"DEPLOYMENT_ENVIRONMENT": "production",
		"BILLING_ENABLED": "false",
		"GOOGLE_PLAY_LIFECYCLE_ENABLED": "false",
		"AI_ASSISTANT_ENABLED": "false",
		"ENTITLEMENTS_ENABLED": "false",
		"AUTH_IDENTITY_ENABLED": "true",
		// Held closed until the release gates in docs/product/production-auth-plan.md
		// are met — Play signing is still outstanding. Staging keeps these enabled
		// so the flow stays testable. Flip together with those docs, not before.
		"ONBOARDING_ENABLED": "false",
		"PASSKEY_ENABLED": "false",
		"PHONE_CHANGE_ENABLED": "true",
		"STATIC_CITY_CATALOG_ENABLED": "true",
		"BUSINESS_TAXONOMY_ENABLED": "true",
		// Whether the nightly media sweep may actually delete from R2. While
		// "false" it adopts untracked objects and reports what it would remove,
		// which is the only way to check the reference query against real data
		// before letting it act. Flip staging first, read a media_reclaim_dry_run
		// line, confirm the count and the sample are objects that should go, and
		// only then consider production. The failure mode of getting this wrong
		// is a seller's live product photos, so it stays closed by default in
		// both environments — unlike the feature flags above, where staging
		// leads.
		"MEDIA_RECLAIM_ENABLED": "false",
		"AI_MONTHLY_BUDGET_MICRO_USD": "0",
		"GOOGLE_PLAY_PACKAGE_NAME": "app.orderak.seller",
		// Package the /.well-known/assetlinks.json statement vouches for. This
		// was hardcoded in assetLinksResponse() until 2026-09-10; naming it here
		// is what lets staging vouch for its own suffixed package instead of
		// borrowing production's. The value below is the previous hardcoded
		// default, so production behaviour is unchanged.
		"ANDROID_APP_PACKAGE_NAME": "app.orderak.seller",
		// Origin every public link is built from — store_url in API responses,
		// canonical/og tags, the 301 that canonicalises an alias, and uploaded
		// media URLs. Was hardcoded to production in identity.ts, so staging
		// emitted production links for stores that exist only in staging's D1
		// and redirected visitors straight into a production 404.
		"PUBLIC_SITE_URL": "https://orderak.app",
		"LOCAL_JWT_VERIFICATION": "false",
		"FIREBASE_PROJECT_ID": ""
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": ["17 2 * * *", "32 2 * * *", "47 2 * * *", "2 3 * * *"]
	},
	"routes": [
		{ "pattern": "orderak.app", "custom_domain": true },
		{ "pattern": "www.orderak.app", "custom_domain": true },
		{ "pattern": "api.orderak.app", "custom_domain": true }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
	],
	"d1_databases": [
		{
			"binding": "orderak_db",
			"database_name": "orderak-db",
			"database_id": "db325720-89fa-4572-87f8-9767b02053d9"
		},
		{
			"binding": "orderak_geo",
			"database_name": "orderak-geo",
			"database_id": "41891664-fe6b-48b2-97b1-3fa6c5b5ce0c",
			"migrations_dir": "geo-migrations"
			// Read replication is NOT a wrangler binding field — wrangler ignores it and warns
			// "Unexpected fields found in d1_databases[1]". Enable per-database via the
			// Cloudflare dashboard (D1 > orderak-geo > Settings) or REST API; the
			// withSession("first-unconstrained") calls in catalog/geo.ts then take effect.
		}
	],
	"r2_buckets": [
		{
			"binding": "orderak_media",
			"bucket_name": "orderak-media"
		}
	],
	"queues": {
		"producers": [
			{ "binding": "PLAY_BILLING_QUEUE", "queue": "orderak-play-billing" },
			{ "binding": "EMAIL_QUEUE", "queue": "orderak-email" }
		],
		"consumers": [
			{
				"queue": "orderak-email",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"max_concurrency": 10,
				"dead_letter_queue": "orderak-email-dlq"
			},
			{ "queue": "orderak-email-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
		]
	},
	"send_email": [
		{ "name": "EMAIL", "remote": true }
	],
	"assets": {
		"directory": "./assets",
		"not_found_handling": "none"
	},
	// Confirmed present on the Production Worker 2026-08-13.
	//
	// Production also carries ADMIN_API_KEY and ADMIN_JWT_SECRET on this
	// Worker. They are NOT required here on purpose: no admin route is mounted
	// on the public Worker, nothing reads either value, and they are recorded
	// in docs/runbooks/secret-rotation.md as candidates for deletion. Declaring
	// them required would make a vestigial credential permanent by turning its
	// removal into a deploy failure.
	"secrets": {
		"required": [
			"BUYER_PRIVACY_PEPPER",
			"DEEPSEEK_API_KEY",
			"FIREBASE_WEB_API_KEY",
			"FORWARD_TO",
			"PAYMENT_WEBHOOK_SECRET",
			"SENTRY_DSN"
		]
	},
	"env": {
		"staging": {
			"name": "orderak-worker-staging",
			"workers_dev": true,
			"preview_urls": false,
			// Staging runs with billing, AI and email forwarding off, so it
			// carries only what it actually calls. Requiring Production's
			// provider credentials here would fail every staging deploy for
			// services this environment does not use.
			//
			// SENTRY_DSN is required in both environments as of 2026-09-06.
			// Sentry is wired in both Workers and no-ops silently when the DSN is
			// unset, so nothing proved errors were aggregating anywhere — the
			// failure mode of an observability tool that is not there is that
			// everything looks quiet. Requiring it turns "was it ever set?" from
			// a question nobody can answer into a deploy that stops.
			"secrets": {
				"required": [
					"BUYER_PRIVACY_PEPPER",
					"FIREBASE_WEB_API_KEY",
					"SENTRY_DSN"
				]
			},
			"vars": {
				"DEPLOYMENT_ENVIRONMENT": "staging",
				"BILLING_ENABLED": "false",
				"GOOGLE_PLAY_LIFECYCLE_ENABLED": "false",
				"AI_ASSISTANT_ENABLED": "false",
				// Work item 03b, staging only, 2026-09-06. Production stays
				// "false" until a staging snapshot has been watched — the plan
				// calls this a release rather than a config change because it
				// swaps the source of every gate and meter in the app at once,
				// and it is the first real exercise of a subsystem that has
				// never served a request.
				//
				// Safe to flip because the shape is held by test rather than by
				// hope: entitlements.spec asserts the engine and the legacy path
				// answer with the same key set and the same per-key fields, so
				// the client cannot tell which one replied (I-4). Item 11 has
				// landed, so the engine no longer grants a customer editor that
				// does not exist.
				"ENTITLEMENTS_ENABLED": "true",
				"AUTH_IDENTITY_ENABLED": "true",
				"ONBOARDING_ENABLED": "true",
				"PASSKEY_ENABLED": "true",
				"PHONE_CHANGE_ENABLED": "true",
				"STATIC_CITY_CATALOG_ENABLED": "true",
				"BUSINESS_TAXONOMY_ENABLED": "true",
				// See the production comment: closed here too, and this is the
				// environment where it opens first once a dry run has been read.
				"MEDIA_RECLAIM_ENABLED": "false",
				"AI_MONTHLY_BUDGET_MICRO_USD": "0",
				// Staging has its own Play Console entry. The staging Android
				// flavour applies applicationIdSuffix = ".staging", so a staging
				// build is a different app to Google, with its own products —
				// product ids are scoped per app. The mapping lookup binds this
				// value, and migration 054 carries a set of mappings for each
				// package, so this string is what selects between them. Pointing
				// it at the production package would make staging purchases
				// resolve against production's products.
				"GOOGLE_PLAY_PACKAGE_NAME": "app.orderak.seller.staging",
				// Same reason as the Play package above: a staging build is a
				// different app, so the Asset Links statement served from
				// staging.orderak.app has to name the suffixed package or
				// Credential Manager refuses every Passkey ceremony.
				"ANDROID_APP_PACKAGE_NAME": "app.orderak.seller.staging",
				// See the production comment: staging serves the same routes
				// from its own domain over its own D1, so its links must name
				// its own origin.
				"PUBLIC_SITE_URL": "https://staging.orderak.app",
				// Scopes staging Passkeys to the staging domain. Without this,
				// rpId() falls through to orderak.app and the production domain
				// would have to vouch for a debug-signed build to make staging
				// Passkeys work — a credential issued for the real RP. Staging
				// credentials are deliberately not portable to production.
				"WEBAUTHN_RP_ID": "staging.orderak.app",
				"LOCAL_JWT_VERIFICATION": "true",
				"FIREBASE_PROJECT_ID": "orderak-staging"
			},
			"triggers": {
				"crons": ["17 2 * * *", "32 2 * * *", "47 2 * * *", "2 3 * * *"]
			},
			"routes": [
				{ "pattern": "staging.orderak.app", "custom_domain": true },
				{ "pattern": "api.staging.orderak.app", "custom_domain": true }
			],
			"durable_objects": {
				"bindings": [
					{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
				]
			},
			"d1_databases": [
				{
					"binding": "orderak_db",
					"database_name": "orderak-db-staging",
					"database_id": "86871840-31c5-4ce0-8b33-5edfd6dc91d0"
				},
				{
					"binding": "orderak_geo",
					"database_name": "orderak-geo-staging",
					"database_id": "9472986d-38cb-4985-86e7-4dd82deb906d",
					"migrations_dir": "geo-migrations"
					// See production note above: enable read replication via dashboard/API, not here.
				}
			],
			"r2_buckets": [
				{
					"binding": "orderak_media",
					"bucket_name": "orderak-media-staging"
				}
			],
			"queues": {
				"producers": [
					{ "binding": "PLAY_BILLING_QUEUE", "queue": "orderak-play-billing-staging" },
					{ "binding": "EMAIL_QUEUE", "queue": "orderak-email-staging" }
				],
				"consumers": [
					{
						"queue": "orderak-email-staging",
						"max_batch_size": 10,
						"max_batch_timeout": 5,
						"max_retries": 5,
						"max_concurrency": 10,
						"dead_letter_queue": "orderak-email-dlq-staging"
					},
					{ "queue": "orderak-email-dlq-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3 }
				]
			},
			"send_email": [
				{ "name": "EMAIL", "remote": true }
			],
			"assets": {
				"directory": "./assets",
				"not_found_handling": "none"
			}
		}
	}
}
