{
  "name": "orderak-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "npm run deploy:staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:staging:admin": "wrangler deploy --config wrangler.admin.jsonc --env staging",
    "deploy:production": "wrangler deploy --env=\"\"",
    "deploy:production:admin": "wrangler deploy --config wrangler.admin.jsonc --env=\"\"",
    "dev:admin": "wrangler dev --config wrangler.admin.jsonc --var LOCAL_ADMIN_ENABLED:true",
    "dev": "wrangler dev --var LOCAL_ADMIN_ENABLED:true",
    "start": "wrangler dev --var LOCAL_ADMIN_ENABLED:true",
    "test": "vitest",
    "test:d1-restore": "node --test scripts/verify-d1-restore.node-test.mjs",
    "smoke:admin": "node test/smoke-admin.mjs",
    "smoke:password": "node test/smoke-password.mjs",
    "geo:build-import": "node scripts/import-csc-cities.mjs",
    "geo:build-geonames-rollback": "node scripts/import-geonames.mjs",
    "test:types": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "verify:architecture": "node scripts/verify-architecture-map.mjs",
    "design-system:generate": "tsx scripts/generate-design-system-fixture.ts --write",
    "design-system:check": "tsx scripts/generate-design-system-fixture.ts",
    "design-system:benchmark": "tsx scripts/benchmark-design-system.ts",
    "design-system:seed": "tsx scripts/seed-design-system.ts",
    "design-system:recovery-sql": "tsx scripts/generate-design-system-recovery-sql.ts",
    "cf-typegen": "wrangler types src/generated/public-worker-env.d.ts --config wrangler.jsonc --env-file wrangler-types.env --env-interface PublicWorkerBindings --strict-vars=false && wrangler types src/generated/admin-worker-env.d.ts --config wrangler.admin.jsonc --env-file wrangler-types.env --env-interface AdminWorkerBindings --strict-vars=false --include-runtime=false",
    "cf-types:check": "wrangler types src/generated/public-worker-env.d.ts --config wrangler.jsonc --env-file wrangler-types.env --env-interface PublicWorkerBindings --strict-vars=false --check && wrangler types src/generated/admin-worker-env.d.ts --config wrangler.admin.jsonc --env-file wrangler-types.env --env-interface AdminWorkerBindings --strict-vars=false --include-runtime=false --check",
    "lint": "oxlint --type-aware src",
    "reconcile:stock": "node scripts/reconcile-stock.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:drift": "node scripts/verify-cloudflare-drift.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "fontkit": "2.0.4",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "@material/material-color-utilities": "0.3.0",
    "@sentry/cloudflare": "^10.70.0",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.13.3",
    "jose": "^6.2.9",
    "libphonenumber-js": "^1.13.11",
    "postal-mime": "^2.7.5",
    "zod": "^4.4.3"
  }
}
