{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  // `include` stays limited to the tests. `files` additionally roots the edge
  // Worker's ambient declarations: edge-worker.test.ts imports @/edge/worker,
  // which pulls worker.ts into this program, and it needs the EdgeEnv/Fetcher
  // globals that live beside it in src/edge.
  "files": ["src/edge/runtime.d.ts", "src/edge/worker-configuration.d.ts"],
  "include": ["src/tests"],
  "exclude": []
}
