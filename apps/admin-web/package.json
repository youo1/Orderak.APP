{
  "name": "@orderak/admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src e2e playwright.config.ts",
    "preview": "vite preview",
    "deploy": "npm run deploy:staging",
    "deploy:staging": "npm run build && wrangler deploy --config wrangler.edge.staging.jsonc",
    "deploy:staging:edge": "npm run deploy:staging",
    "deploy:production": "npm run build && wrangler deploy --config wrangler.edge.jsonc --env=\"\"",
    "deploy:production:edge": "npm run deploy:production",
    "cf-typegen": "wrangler types src/edge/worker-configuration.d.ts --config wrangler.edge.jsonc --env-interface EdgeEnv --strict-vars=false --include-runtime=false",
    "cf-types:check": "wrangler types src/edge/worker-configuration.d.ts --config wrangler.edge.jsonc --env-interface EdgeEnv --strict-vars=false --include-runtime=false --check",
    "test": "vitest run",
    "test:a11y": "vitest run src/tests/accessibility.test.tsx",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@sentry/react": "^10.71.0",
    "@tanstack/react-query": "^5.102.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^28.0.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
