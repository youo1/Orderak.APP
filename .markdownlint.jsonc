{
  "default": true,
  "line-length": false,
  "no-duplicate-heading": { "siblings_only": true },
  "no-inline-html": false,
  "no-bare-urls": false,
  "no-trailing-punctuation": false,
  "first-line-h1": false,
  "single-trailing-newline": true,
  "no-emphasis-as-heading": false,
  "table-column-style": false
}
